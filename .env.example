# Reference only: Next.js reads server values from apps/api/.env.local, while
# WXT reads WXT_* values when building the extension. Prefer the app-specific
# example files for a new setup.
PERSPECTICA_MODE=chatgpt
PERSPECTICA_PIPELINE_VERSION=2026-07-29.1
PERSPECTICA_PROMPT_VERSION=agentic-research-v1
PERSPECTICA_EXTENSION_ORIGIN=chrome-extension://daefmnkkogfkfmmikoomfmkdkfknilff
PERSPECTICA_DB_PATH=data/perspectica.sqlite
# Optional for local development because Perspectica creates a durable 0600 key file.
# Required as a strong secret in a deployed environment.
PERSPECTICA_SESSION_SECRET=
# GPT-5.6 may be accepted by the Codex endpoint before it appears in /models.
PERSPECTICA_CODEX_CLIENT_VERSION=0.144.4
PERSPECTICA_MANUAL_CHATGPT_MODELS=gpt-5.6-luna
PERSPECTICA_CHATGPT_MODEL=gpt-5.6-luna
PERSPECTICA_CHATGPT_REASONING_EFFORT=medium
PERSPECTICA_ALLOWED_CHATGPT_MODELS=gpt-5.6-luna,gpt-5.4
# Server-only Exa credential used by the six bounded research specialists.
EXA_API_KEY=
PERSPECTICA_COOKIE_SECURE=true
WXT_API_BASE_URL=http://localhost:3000
WXT_PERSPECTICA_MODE=chatgpt
