{
  "name": "perspectica",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.15.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dataset:spectrum:collect": "node scripts/collect-spectrum-calibration.mjs",
    "dataset:spectrum:summarize": "node scripts/summarize-spectrum-dataset.mjs",
    "dataset:spectrum:validate": "node scripts/validate-spectrum-dataset.mjs",
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @perspectica/extension dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:extension-package": "node scripts/check-extension-package.mjs",
    "package:extension": "pnpm --filter @perspectica/extension zip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "verify:release": "pnpm verify && pnpm package:extension && pnpm check:extension-package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "happy-dom": "^18.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
