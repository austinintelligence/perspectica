# Copy this file to apps/api/.env.local for local development.
# Never commit the copied file or a real credential.
PERSPECTICA_MODE=chatgpt
PERSPECTICA_PIPELINE_VERSION=2026-07-29.1
PERSPECTICA_PROMPT_VERSION=agentic-research-v1
PERSPECTICA_EXTENSION_ORIGIN=chrome-extension://daefmnkkogfkfmmikoomfmkdkfknilff
PERSPECTICA_DB_PATH=data/perspectica.sqlite

# Local development creates a durable owner-only key file when this is empty.
# Set a strong secret in any deployed environment.
PERSPECTICA_SESSION_SECRET=
PERSPECTICA_CODEX_CLIENT_VERSION=0.144.4
PERSPECTICA_MANUAL_CHATGPT_MODELS=gpt-5.6-luna
PERSPECTICA_CHATGPT_MODEL=gpt-5.6-luna
PERSPECTICA_CHATGPT_REASONING_EFFORT=medium
PERSPECTICA_ALLOWED_CHATGPT_MODELS=gpt-5.6-luna,gpt-5.4
EXA_API_KEY=

# HTTPS deployments should keep this true. localhost development may set it to false.
PERSPECTICA_COOKIE_SECURE=true
